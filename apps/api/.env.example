SHCA_ENV=development
SHCA_API_HOST=0.0.0.0
SHCA_API_PORT=8000
SHCA_DATABASE_URL=sqlite:///./self_healing.db
SHCA_GITHUB_API_URL=https://api.github.com
SHCA_GITHUB_WEB_URL=https://github.com
SHCA_GITHUB_APP_ID=local-dev
SHCA_GITHUB_INSTALLATION_ID=
SHCA_GITHUB_PRIVATE_KEY=
SHCA_GITHUB_WEBHOOK_SECRET=local-secret
SHCA_ENABLE_GITHUB_WRITEBACK=false
SHCA_ENABLE_VALIDATION_EXECUTION=false
SHCA_ENABLE_VALIDATION_REPO_SYNC=false
SHCA_VALIDATION_CHECKOUT_ROOT=./.cache/validation_repos
SHCA_ENABLE_LLM_PATCH_GENERATION=false
SHCA_LLM_PATCH_PROVIDER=openai
SHCA_LLM_PATCH_MODEL=gpt-4.1-mini
SHCA_OPENAI_API_KEY=
SHCA_OPENAI_API_BASE_URL=https://api.openai.com/v1
SHCA_ARTIFACT_STORAGE_PATH=./artifacts
